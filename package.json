{
  "name": "gwent-thai-wiki",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "data": "python3 pipeline/build_data.py",
    "art": ".venv/bin/python pipeline/check_art.py",
    "art:refresh": ".venv/bin/python pipeline/check_art.py --refresh",
    "art:web": ".venv/bin/python pipeline/web_art.py",
    "dev": "vite --port 5190 --host",
    "typecheck": "tsc --noEmit",
    "build:single": "tsc --noEmit && vite build --mode single && mv dist-single/index.html dist-single/GWENT-Thai-wiki.html",
    "build:web": "tsc --noEmit && vite build",
    "preview": "vite preview --port 5191 --host",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:web": "BASE=/GWENT-Thai-wiki/ npm run build:web && BASE=/GWENT-Thai-wiki/ playwright test -c playwright.web.config.ts",
    "shots": "SHOTS=1 playwright test tests/e2e/shots.spec.ts"
  },
  "dependencies": {
    "@tanstack/react-virtual": "3.14.21",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vite-plugin-singlefile": "2.3.4",
    "vitest": "5.0.5"
  }
}
